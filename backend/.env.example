# Backend configuration. Copy to `.env` (gitignored) and adjust as needed:
#   cp .env.example .env
# Real environment variables take precedence over values in `.env`.
# Never commit real secrets; this file holds safe defaults only.

# Deployment environment: development | test | production
# In production, the interactive API docs (/docs, /redoc) are disabled.
CLOUDOPS_ENVIRONMENT=development

# Display name shown in the API docs.
CLOUDOPS_APP_NAME="CloudOps AI"

# PostgreSQL connection. Defaults match infra/postgres/.env.example, so the
# local Docker database works out of the box. The password has no default in
# code and must be set here or in the environment.
CLOUDOPS_POSTGRES_HOST=127.0.0.1
CLOUDOPS_POSTGRES_PORT=5432
CLOUDOPS_POSTGRES_USER=cloudops
CLOUDOPS_POSTGRES_PASSWORD=cloudops-local-dev
CLOUDOPS_POSTGRES_DB=cloudops
# Tests use a separate database named "<CLOUDOPS_POSTGRES_DB>_test" (created
# automatically), so running them never touches your development data.
