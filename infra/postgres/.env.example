# Local PostgreSQL settings. Copy to `.env` in this folder (gitignored):
#   cp .env.example .env
# These are local-development values only. Change the password if you like;
# never reuse it anywhere real.

POSTGRES_USER=cloudops
POSTGRES_PASSWORD=cloudops-local-dev
POSTGRES_DB=cloudops

# Host port (bound to 127.0.0.1). Change it if 5432 is already in use.
POSTGRES_PORT=5432
